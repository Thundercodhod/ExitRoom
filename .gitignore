# Godot-generated cache and import metadata
.godot/
*.import
# Except: the player model's import settings rename its bones to Godot's
# humanoid names (player_better_rig_bone_map.tres); without them the player's
# animations do not bind.
!assets/models/player/player_better_rig.glb.import
*.log

# Local captures used while checking the game
preview-*.png

# Keep only models used by the playable project. Other source models and
# textures extracted from GLBs stay local and can be imported again.
3Dmodel_import/*
!levels/02_after_hours/assets/original_backrooms.glb
!3Dmodel_import/backrooms_rigged_hazmat.glb
!3Dmodel_import/low-poly_furnished_abandoned_house.glb
!levels/05_realization/assets/pladuk.glb
assets/*
!assets/abandoned_house_playable.glb
!assets/textures/
!assets/shaders/
!assets/models/
!levels/05_realization/assets/psx_forest/
# Textures Godot extracts next to a GLB stay local (the GLB embeds them).
assets/models/**/*.png
assets/models/**/*.jpg

# Local, unneeded font copy
/fonts/
.buildtmp/
tools/house-inspection.json
build/

# Texture copies Godot extracts from GLBs during import (the GLB embeds them).
levels/05_realization/assets/pladuk_*.png
# Texture copies extracted from the tree GLBs during import.
tree/dead_tree_*.png
tree/tree_ps1psx_style_*.png

# Source libraries and optional editor tools stay in ExitRoom_SourceLibrary.
/addons/
/.claude/
*.zip
*.blend1
/assets_src/

# Runtime surface mipmaps are authored settings: keep them on clean web builds.
!assets/textures/**/*.import
!assets/textures/*.import
!assets/abandoned_house_playable_Image_*.jpg.import
!assets/abandoned_house_playable_Image_*.png.import
!levels/03_room407/assets/textures/*.jpg.import
!levels/03_room407/assets/models/*.jpg.import
!levels/03_room407/assets/models/*.png.import
!Grass/assets/BinbunGrass/src/texture/basic/grass_basic_*.png.import
!levels/02_after_hours/assets/original_backrooms_*.png
!levels/02_after_hours/assets/original_backrooms_*.png.import

# Downloaded source packs stay local; only prepared dream-field resources ship.
/source_assets/
!levels/06_dream_field/assets/
!levels/06_dream_field/assets/**/*.import
!levels/06_dream_field/assets/*.import
!levels/06_dream_field/audio/*.import
/psx-skyboxes-free/
/psx-skyboxes-free-assets/
/PSX Natural Ground Textures SAMPLE/
/psx-haunted-chapel_free-sample_v1.0.2/
/handpainted_fat_cat_statue_-_ghibli_style*
